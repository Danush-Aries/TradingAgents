# ============================================================
# TradingAgents Environment Configuration
# Copy this file to .env and fill in your API keys.
# Only set the keys for providers and data sources you use.
# ============================================================

# --- LLM Providers (set the one you use) ---
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=       # Alibaba Cloud (Qwen models)
ZHIPU_API_KEY=           # Zhipu AI (GLM models)
OPENROUTER_API_KEY=

# --- Data Vendors ---
# Alpha Vantage (optional — the default data vendor is yfinance which needs no key)
# Get a free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# --- Storage / Directories (optional overrides) ---
# TRADINGAGENTS_RESULTS_DIR=~/.tradingagents/logs
# TRADINGAGENTS_CACHE_DIR=~/.tradingagents/cache
# TRADINGAGENTS_MEMORY_LOG_PATH=~/.tradingagents/memory/trading_memory.md
